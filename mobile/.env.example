# ChugLi Mobile - Public Configuration
# Copy to .env and fill in values from CDK outputs
# NEVER commit real credentials or secrets

EXPO_PUBLIC_APPSYNC_GRAPHQL_URL=https://xxxxxxxxxx.appsync-api.us-east-1.amazonaws.com/graphql
EXPO_PUBLIC_AWS_REGION=us-east-1
EXPO_PUBLIC_COGNITO_IDENTITY_POOL_ID=us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
EXPO_PUBLIC_APPSYNC_API_ID=xxxxxxxxxx

# Development only - not used in production builds
EXPO_PUBLIC_DEV_MODE=true